class Solution {
public:
    vector<int> intersection(vector<int>& nums1, vector<int>& nums2) {
        sort(nums1.begin(),nums1.end());
        sort(nums2.begin(),nums2.end());
        int n1 = nums1.size();
        int n2 = nums2.size();
        int n = max(n1,n2);
        int i = 0;
        int j=0;
        vector<int> temp;
        while(i<n1 && j<n2)
        {
            if(nums1[i] < nums2[j])
            {
                i++;
            }
            else if(nums1[i]>nums2[j]){
                j++;
            }
            else
            {
                if(!temp.empty()&& temp.back()==nums1[i]){
                  i++;
                  j++;
                  continue;
                }
                temp.push_back(nums1[i]);
                i++;
                j++;
                
            }
        }
     
       return temp; 
      
    }
};


2nd approach:

class Solution {
public:
    vector<int> intersection(vector<int>& nums1, vector<int>& nums2) {
        int n = nums2.size();
        set<int> st1;
        for(auto i:nums1)
        {
            st1.insert(i);
        }
        vector<int> res;
        for(int i = 0;i<n;i++)
        {
            if(st1.count(nums2[i]))
            {
                res.push_back(nums2[i]);
                st1.erase(nums2[i]);
            }
        }
        return res;
    }
};
