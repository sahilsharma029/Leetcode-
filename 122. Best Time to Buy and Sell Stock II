class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int maxp = 0;
        for(int i = 1; i<prices.size(); i++)
        {
            if(prices[i] > prices[i-1])
            {
                maxp = maxp + (prices[i] - prices[i-1]);
            }
        }
        return maxp;
    }
};

Time Complexity: O(N)
Space Complexity: O(1)
